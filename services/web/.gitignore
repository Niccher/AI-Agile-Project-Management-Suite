# Environment variables
.env
.env.backup
.env.testing

# Dependencies
vendor/
node_modules/

# User uploads and generated files
writable/uploads/*
!writable/uploads/index.html
writable/reports/*
!writable/reports/index.html
public/uploads/avatars/*

# Logs, Cache, Sessions and Debug
writable/cache/*
!writable/cache/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/debugbar/*
!writable/debugbar/index.html

# IDEs and OS files
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Custom unused scripts
refactor_*.py
fix-*.sh
