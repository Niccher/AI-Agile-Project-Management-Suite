# ==============================================================================
# AI-Agile-Project-Management-Suite - Environment Configuration
# ==============================================================================

# Application Environment (development | production)
CI_ENVIRONMENT=development
APP_ENV=development

# WebApp Host & Standard Port (Default: 80)
WEB_PORT=80
APP_URL=http://localhost

# ML Microservice & LLM Inference (Default: 8000)
ML_PORT=8000
ML_SERVICE_URL=http://ml-chege-jira:8000
ML_API_KEY=chege_jira_ml_super_secret_key_2026
DEFAULT_MODEL=phi3-mini
N_THREADS=4
N_CTX=4096

# MySQL Database (Internal to Docker Network - Port 3306)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=db_chege_jira
DB_USER=root
DB_PASSWORD=root_password
DB_ROOT_PASSWORD=root_password

# Redis Cache & Task Queue (Internal to Docker Network - Port 6379)
REDIS_URL=redis://redis:6379/0

# Admin Seeder Defaults
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password_123

# MinIO S3-Compatible Object Storage
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_super_secret_2026
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_super_secret_2026
S3_REGION=us-east-1
S3_BUCKET_ATTACHMENTS=agile-attachments
S3_BUCKET_AVATARS=agile-avatars
S3_BUCKET_BACKUPS=agile-backups
S3_DIRECT_PRESIGNED=true

# Dozzle Real-Time Log Viewer (Port 8888)
DOZZLE_PORT=8888
DOZZLE_AUTH_PROVIDER=none
DOZZLE_USER=admin
DOZZLE_PASSWORD=admin_password_123
