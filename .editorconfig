# EditorConfig configuration for AI-Agile-Project-Management-Suite
# http://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php,phtml}]
indent_size = 4
indent_style = space

[*.{py,pyi}]
indent_size = 4
indent_style = space

[*.{yml,yaml,json}]
indent_size = 2
indent_style = space

[*.{js,ts,css,scss,html}]
indent_size = 2
indent_style = space

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
